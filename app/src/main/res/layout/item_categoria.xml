<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <View
            android:id="@+id/view_indicator"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="#050A30"
            app:layout_constraintBottom_toBottomOf="@+id/tv_tipo_categoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_nombre_categoria" />

        <TextView
            android:id="@+id/tv_nombre_categoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:text="Alimentación"
            android:textColor="#050A30"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_anadir_gasto"
            app:layout_constraintStart_toEndOf="@+id/view_indicator"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_tipo_categoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Supermercado, Almuerzos"
            android:textColor="#8B8383"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_anadir_gasto"
            app:layout_constraintStart_toEndOf="@+id/view_indicator"
            app:layout_constraintTop_toBottomOf="@+id/tv_nombre_categoria" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_anadir_gasto"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#F4F6FC"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="#050A30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#F4F6FC"
            app:layout_constraintTop_toBottomOf="@+id/tv_tipo_categoria" />

        <TextView
            android:id="@+id/tv_label_disponible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Disponible"
            android:textColor="#8B8383"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <TextView
            android:id="@+id/tv_presupuesto_categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$54.50 restantes"
            android:textColor="#B79347"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_label_disponible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_label_disponible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_categoria_progreso"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            app:indicatorColor="#B79347"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_disponible"
            app:trackColor="#F4F6FC"
            app:trackCornerRadius="5dp" />

        <TextView
            android:id="@+id/tv_gastado_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Gastado: $145.50 de $200.00"
            android:textColor="#8B8383"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pb_categoria_progreso" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>