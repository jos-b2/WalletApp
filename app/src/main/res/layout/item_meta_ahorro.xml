<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <View
            android:id="@+id/view_indicator_meta"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="#B79347"
            app:layout_constraintBottom_toBottomOf="@+id/tv_porcentaje_meta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_nombre_meta" />

        <TextView
            android:id="@+id/tv_nombre_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:text="Nintendo Switch OLED"
            android:textColor="#050A30"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_porcentaje_meta"
            app:layout_constraintStart_toEndOf="@+id/view_indicator_meta"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_porcentaje_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F4F6FC"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0%"
            android:textColor="#B79347"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_meta"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            app:indicatorColor="#B79347"
            app:layout_constraintTop_toBottomOf="@+id/tv_nombre_meta"
            app:trackColor="#F4F6FC"
            app:trackCornerRadius="5dp" />

        <TextView
            android:id="@+id/tv_montos_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="$0.00 / $350.00"
            android:textColor="#8B8383"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_abonar_meta"
            app:layout_constraintEnd_toStartOf="@+id/btn_abonar_meta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_abonar_meta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_abonar_meta"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="20dp"
            android:text="+ Abonar"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#050A30"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pb_meta" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>